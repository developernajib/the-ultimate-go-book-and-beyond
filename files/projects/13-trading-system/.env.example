# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trading?sslmode=disable

# Exchange WebSocket
EXCHANGE_URL=wss://api.exchange.com/ws
EXCHANGE_API_KEY=
EXCHANGE_SECRET=

# Risk limits
MAX_ORDER_SIZE=10.0
MAX_POSITION_SIZE=100.0
MAX_DAILY_LOSS=10000.0

# Observability
METRICS_PORT=9090

# Runtime tuning
GC_PERCENT=200
MAX_GOROUTINES=10000
ENABLE_CPU_PROFILE=false

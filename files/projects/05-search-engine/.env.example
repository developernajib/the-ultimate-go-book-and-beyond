# ── HTTP Server ───────────────────────────────────────────────────────────────

# Listen address for the HTTP API
SERVER_ADDR=:8080

# ── Index ─────────────────────────────────────────────────────────────────────

# Directory where on-disk index segments are stored (leave empty for in-memory only)
INDEX_DATA_DIR=./data

# Maximum number of query results held in the LRU cache
INDEX_MAX_CACHE=10000

# Default text analyzer: english | standard
INDEX_ANALYZER=english

# Default search operator when none is specified: AND | OR
INDEX_DEFAULT_OPERATOR=OR

# Maximum documents returned per query (hard cap)
INDEX_MAX_PAGE_SIZE=1000

# Default page size when the client does not specify ?limit=
INDEX_DEFAULT_PAGE_SIZE=10

# ── Sharding ──────────────────────────────────────────────────────────────────

SHARD_COUNT=1
REPLICATION_FACTOR=1

# ── Storage ───────────────────────────────────────────────────────────────────

# Compression codec for on-disk segments: none | snappy | zstd
STORAGE_COMPRESSION=snappy

# In-memory segment cache size in bytes (default 256 MB)
STORAGE_CACHE_SIZE=268435456

# ── Logging ───────────────────────────────────────────────────────────────────

# debug | info | warn | error
LOG_LEVEL=info

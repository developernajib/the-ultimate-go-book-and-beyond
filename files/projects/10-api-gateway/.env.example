# =============================================================
# API Gateway - Environment Variables
# Copy this file to .env and fill in your values.
# The gateway reads configs/gateway.yaml for most settings.
# These variables override or supplement gateway.yaml values.
# =============================================================

# ── Gateway Server ────────────────────────────────────────────
# Gateway config file path (passed via --config flag)
CONFIG_PATH=configs/gateway.yaml

# ── Admin API ─────────────────────────────────────────────────
# API key required for all admin API requests (X-API-Key header).
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=change-me-generate-a-real-key

# ── Redis ─────────────────────────────────────────────────────
# Redis address used by the rate-limit plugin (sliding window counter)
# and the cache plugin.
REDIS_ADDR=localhost:6379

# Redis password (leave empty if no auth)
REDIS_PASSWORD=

# Redis database number (0-15)
REDIS_DB=0

# ── Authentication Plugins ────────────────────────────────────
# Default HMAC secret for the JWT auth plugin (HS256).
# Each route can override this in its plugin config.
JWT_SECRET=change-me-to-a-real-jwt-secret

# ── Rate Limiting ─────────────────────────────────────────────
# Global default rate limit (requests per window).
# Individual routes override this in their plugin config.
RATE_LIMIT_DEFAULT=1000
RATE_LIMIT_WINDOW=1m

# ── TLS ───────────────────────────────────────────────────────
# Set TLS_ENABLED=true and provide cert/key paths for HTTPS termination.
TLS_ENABLED=false
# TLS_CERT_FILE=certs/server.crt
# TLS_KEY_FILE=certs/server.key
# TLS_MIN_VERSION=TLS1.2

# ── Distributed Tracing ───────────────────────────────────────
# OTLP HTTP endpoint for trace export (Jaeger, Tempo, etc.)
TRACING_ENABLED=true
TRACING_ENDPOINT=http://localhost:4318
TRACING_SAMPLING_RATE=1.0

# ── Logging ───────────────────────────────────────────────────
# Log level: debug | info | warn | error
LOG_LEVEL=info

# Log format: json | console
LOG_FORMAT=json

# ── Metrics ───────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_NAMESPACE=gatewaygo

# ── Upstream Defaults ─────────────────────────────────────────
# Default upstream request timeout
UPSTREAM_TIMEOUT=30s

# Default number of retries before marking a request failed
UPSTREAM_RETRIES=3

# ── Circuit Breaker Defaults ──────────────────────────────────
# Number of failures before opening the circuit
CIRCUIT_FAILURE_THRESHOLD=5

# How long to wait in Open state before attempting a probe
CIRCUIT_RECOVERY_TIMEOUT=60s

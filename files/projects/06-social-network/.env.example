# ── Application ──────────────────────────────────────────────────────────────

# Environment: development | staging | production
APP_ENV=development

# HTTP listen port
PORT=8080

# JWT signing secret (HMAC-SHA256). Use a long random string in production.
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-very-long-random-secret

# JWT token expiry
JWT_EXPIRY=24h

# ── PostgreSQL ────────────────────────────────────────────────────────────────

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=social_network
DB_SSLMODE=disable

# Connection pool tuning
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=25

# Full DSN (used by golang-migrate via Makefile)
# DATABASE_URL is auto-assembled in the Makefile from the above vars.
# Set it explicitly here only if you need to override.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/social_network?sslmode=disable

# ── Redis ────────────────────────────────────────────────────────────────────

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=redis

# Feed TTL in seconds (how long a user's cached feed stays valid)
FEED_CACHE_TTL=300

# ── Neo4j ────────────────────────────────────────────────────────────────────

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# ── Elasticsearch ─────────────────────────────────────────────────────────────

ELASTICSEARCH_URL=http://localhost:9200

# Index names
ES_USERS_INDEX=users
ES_POSTS_INDEX=posts

# ── MinIO ────────────────────────────────────────────────────────────────────

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=social-media
MINIO_USE_SSL=false

# Maximum upload size in bytes (default 10 MB)
MEDIA_MAX_SIZE=10485760

# ── Rate Limiting ─────────────────────────────────────────────────────────────

# Requests per minute per IP
RATE_LIMIT_RPM=100

# ── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins (* for all)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────

# debug | info | warn | error
LOG_LEVEL=info

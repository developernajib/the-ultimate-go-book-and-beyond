# =============================================================
# Observability Platform - Environment Variables
# Copy this file to .env and fill in your values.
# The platform primarily reads configs/config.yaml,
# but these variables can override sensitive values at runtime.
# =============================================================

# ── Server ────────────────────────────────────────────────────
# HTTP API address
HTTP_ADDR=:8080

# gRPC address (OTLP receiver)
GRPC_ADDR=:9090

# ── Storage: Metrics (Prometheus TSDB) ───────────────────────
# Local filesystem path where TSDB data is stored
TSDB_PATH=./data/tsdb

# Retention period for raw metric data
TSDB_RETENTION=360h

# ── Storage: Logs (ClickHouse) ────────────────────────────────
# ClickHouse DSN: clickhouse://user:pass@host:port/database
CLICKHOUSE_DSN=clickhouse://default:@localhost:9000/observability

# ClickHouse database and table for logs
CLICKHOUSE_LOG_DATABASE=observability
CLICKHOUSE_LOG_TABLE=logs

# ── Storage: Traces (ClickHouse) ─────────────────────────────
CLICKHOUSE_TRACE_DATABASE=observability
CLICKHOUSE_SPANS_TABLE=spans
CLICKHOUSE_INDEX_TABLE=traces_index

# ── Ingestion: OTLP ──────────────────────────────────────────
OTLP_ENABLED=true
OTLP_GRPC_ADDR=:4317
OTLP_HTTP_ADDR=:4318

# ── Ingestion: Prometheus Scraper ────────────────────────────
PROMETHEUS_SCRAPER_ENABLED=false
PROMETHEUS_SCRAPE_INTERVAL=15s

# ── Ingestion: StatsD ────────────────────────────────────────
STATSD_ENABLED=true
STATSD_UDP_ADDR=:8125
STATSD_TCP_ADDR=:8126

# ── Ingestion: Logs ──────────────────────────────────────────
LOGS_ENABLED=true
LOGS_SYSLOG_ADDR=:514
LOGS_PARSE_JSON=true

# ── Alerting ─────────────────────────────────────────────────
ALERTING_ENABLED=true
ALERTING_RULES_FILE=configs/alerts.yaml
ALERTING_EVALUATION_INTERVAL=60s

# ── Notifiers ────────────────────────────────────────────────
# Slack webhook URL for alert notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# PagerDuty integration key
# PAGERDUTY_INTEGRATION_KEY=your-integration-key

# SMTP settings for email notifications
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=alerts@example.com
# SMTP_TO=oncall@example.com

# ── Authentication ────────────────────────────────────────────
AUTH_ENABLED=false
# JWT_SECRET=change-me-to-a-real-secret
# TOKEN_EXPIRY=24h

# ── Query Engine ─────────────────────────────────────────────
QUERY_TIMEOUT=2m
MAX_SAMPLES=50000000
MAX_CONCURRENT_QUERIES=20

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
HTTP_PORT=8080

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=product_db
# Increase pool size for production
# DB_MAX_CONNECTIONS=25

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PORT=6379
# Leave empty if no password is set
REDIS_PASSWORD=
# Cart session TTL (Go duration format)
CART_TTL=24h

# ─── NATS ─────────────────────────────────────────────────────────────────────
NATS_URL=nats://localhost:4222
NATS_PORT=4222

# ─── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_PORT=9200

# ─── gRPC Service Addresses ───────────────────────────────────────────────────
GRPC_PORT=50051
PRODUCT_SERVICE_ADDR=localhost:50051

# ─── Tracing (Jaeger) ─────────────────────────────────────────────────────────
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

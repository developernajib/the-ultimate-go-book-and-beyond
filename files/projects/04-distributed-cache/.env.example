# ── GoCache Server ────────────────────────────────────────────────────────────

# TCP address the server listens on
CACHE_ADDR=:6379

# Maximum memory the store is allowed to use (bytes).
# When this limit is hit the LRU eviction policy kicks in.
# Default: 1 073 741 824 (1 GB)
MAX_MEMORY=1073741824

# ── Metrics ───────────────────────────────────────────────────────────────────

# Prometheus metrics HTTP listen address
METRICS_ADDR=:2112

# ── Logging ───────────────────────────────────────────────────────────────────

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# ── Replication ───────────────────────────────────────────────────────────────

# Role of this node: master | replica
REPLICATION_ROLE=master

# Address of the master node (only required when REPLICATION_ROLE=replica)
# MASTER_ADDR=localhost:6379

# ── Cluster ───────────────────────────────────────────────────────────────────

# Comma-separated list of all cluster node addresses
# CLUSTER_NODES=localhost:6379,localhost:6380,localhost:6381

# Number of virtual nodes per physical node on the consistent hash ring
VIRTUAL_NODES=150

# HTTP Server
HTTP_ADDR=:8080
GRPC_ADDR=:9090

# PostgreSQL
DATABASE_URL=postgres://mlplatform:password@localhost:5432/mlplatform?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# MinIO / S3 artifact storage
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ml-platform
S3_USE_SSL=false

# Pipeline
PIPELINE_WORKERS=10

{
  "name": "sentiment-classifier-v1",
  "version": "1.0.0",
  "framework": "pytorch",
  "task": "text-classification",
  "description": "Binary sentiment classification (positive/negative) trained on product reviews",
  "input_schema": {
    "type": "object",
    "properties": {
      "text": { "type": "string", "max_length": 512 }
    },
    "required": ["text"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "label":      { "type": "string", "enum": ["positive", "negative"] },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
    }
  },
  "serving": {
    "max_batch_size": 32,
    "timeout_ms": 200,
    "replicas": 2,
    "resources": {
      "cpu": "1",
      "memory": "2Gi"
    }
  },
  "metadata": {
    "author": "ml-team",
    "training_dataset": "product-reviews-v3",
    "accuracy": 0.924,
    "f1_score": 0.918,
    "created_at": "2024-01-15T10:00:00Z"
  }
}

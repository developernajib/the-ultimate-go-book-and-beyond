# =============================================================
# Kubernetes PostgreSQL Operator - Environment Variables
# Most configuration is via CLI flags (see Makefile).
# These variables are used by the operator process at runtime.
# =============================================================

# ── Operator ──────────────────────────────────────────────────
# Kubernetes namespace the operator pod runs in.
# Used as the leader election namespace when --leader-election-namespace is not set.
POD_NAMESPACE=default

# ── Metrics ───────────────────────────────────────────────────
# Address the Prometheus metrics endpoint listens on.
# Exposed at /metrics on this address.
METRICS_BIND_ADDRESS=:8080

# ── Health Probes ─────────────────────────────────────────────
# Address the liveness (/healthz) and readiness (/readyz) probes listen on.
HEALTH_PROBE_BIND_ADDRESS=:8081

# ── Leader Election ───────────────────────────────────────────
# Enable leader election to allow running multiple operator replicas safely.
LEADER_ELECT=false

# Lease object name used for leader election lock.
LEADER_ELECTION_ID=postgres-operator-leader

# ── Webhook ───────────────────────────────────────────────────
# Port for the admission webhook server.
WEBHOOK_PORT=9443

# Directory containing TLS certificate and key for the webhook server.
# Files expected: tls.crt, tls.key
WEBHOOK_CERT_DIR=/tmp/k8s-webhook-server/serving-certs

# ── Image Defaults ────────────────────────────────────────────
# Default PostgreSQL image applied by the defaulting webhook when spec.image is empty.
DEFAULT_POSTGRES_IMAGE=postgres:16.1

# Default postgres-exporter image applied when monitoring is enabled and no image is set.
DEFAULT_EXPORTER_IMAGE=quay.io/prometheuscommunity/postgres-exporter:latest

# ── Backup ────────────────────────────────────────────────────
# Default S3 endpoint for backup storage (used when spec.backup.s3.endpoint is empty).
# Leave empty to use standard AWS S3.
# BACKUP_S3_ENDPOINT=http://localhost:9000

# ── Development ───────────────────────────────────────────────
# kubebuilder assets path (set automatically by setup-envtest in tests).
# KUBEBUILDER_ASSETS=/tmp/envtest-bins/k8s/1.29.0-linux-amd64

{
	"name": "the-ultimate-go-book-and-beyond",
	"version": "1.0.0",
	"description": "The Ultimate Go Book and Beyond, open source web reader",
	"author": {
		"name": "Md. Najib Islam",
		"email": "developernajib@pm.me"
	},
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"prebuild": "node files/convert-md-files.js",
		"build": "tsc --noEmit && vite build",
		"start": "vite preview --port 3000",
		"preview": "vite preview --port 3000",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src --max-warnings 0",
		"format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
		"check-diagrams": "node files/run-py.cjs files/check-diagrams.py",
		"generate-llms": "node files/generate-llms.js",
		"token-count": "node files/run-py.cjs files/count-tokens.py",
		"token-count:fast": "node files/count-tokens.js"
	},
	"dependencies": {
		"daisyui": "^5.7.47",
		"marked": "18.1.0",
		"prismjs": "1.30.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-router": "8.4.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "^26.6.5",
		"@types/prismjs": "^1.26.6",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"esbuild": "^0.28.2",
		"eslint": "^10.12.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"prettier": "^3.9.9",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.71.1",
		"vite": "8.3.4"
	}
}
